# ─── Browser-safe (inlined into the client bundle) ────────────────────────────
# Backend origin used by the browser for public endpoints and by CSP connect-src.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# Canonical site origin (metadata, sitemaps, OpenGraph URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Base currency the catalog is priced in — NOT a per-visitor preference.
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# ─── Server-only (never prefixed with NEXT_PUBLIC_) ───────────────────────────
# Backend origin as reachable from the Next.js server / BFF proxy.
INTERNAL_API_BASE_URL=https://api.example.com
# "true"/"false" to force Secure cookies; unset derives from NODE_ENV + https.
# Set to false on http-only staging, otherwise cookies are silently dropped.
AUTH_COOKIE_SECURE=
# Shared secret for POST /api/revalidate (openssl rand -hex 32). Unset = endpoint disabled.
REVALIDATE_SECRET=
# "false" on staging/preview keeps the deployment out of search engines.
SITE_ROBOTS_INDEX=true
