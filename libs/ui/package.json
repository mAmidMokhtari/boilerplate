{
  "name": "@repo/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles/globals.css",
    "./*": {
      "@repo/source": "./src/components/*.tsx",
      "types": "./src/components/*.tsx",
      "import": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./lib/*": {
      "@repo/source": "./src/lib/*.ts",
      "types": "./src/lib/*.ts",
      "import": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./blocks/*": {
      "@repo/source": "./src/blocks/*.tsx",
      "types": "./src/blocks/*.tsx",
      "import": "./src/blocks/*.tsx",
      "default": "./src/blocks/*.tsx"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "ui",
    "tags": [
      "type:ui"
    ],
    "sourceRoot": "libs/ui/src",
    "projectType": "library"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@repo/config": "workspace:*",
    "@repo/dtos": "workspace:*",
    "@repo/models": "workspace:*",
    "@repo/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
