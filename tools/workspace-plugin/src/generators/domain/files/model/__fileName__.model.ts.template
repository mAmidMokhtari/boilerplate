import { BaseModel } from "../base/base.model";
import type { I<%= className %>Model } from "./<%= fileName %>.interface";

export class <%= className %>Model extends BaseModel<I<%= className %>Model> {
  getName(): string {
    return this.props.name ?? "";
  }

  getSlug(): string {
    return this.props.slug ?? "";
  }

  isActive(): boolean {
    return this.props.is_active ?? false;
  }
}
