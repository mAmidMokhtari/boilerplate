{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": null,
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "types": ["node"],
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/files/**"]
}
